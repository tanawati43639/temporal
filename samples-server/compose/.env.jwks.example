# Server-side JWT verification for the Temporal frontend (JWKS URI only).
# Copy this file to `.env.jwks` and replace <TENANT_ID> with your Directory
# (tenant) ID. `.env.jwks` is git-ignored. Kept separate from `.env.local`
# so the frontend never receives the OIDC client secret.
TEMPORAL_JWT_KEY_SOURCE1=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys
