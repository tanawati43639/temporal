# Azure (Microsoft Entra ID) OIDC settings for Temporal UI + Server authorization.
# Copy this file to `.env.local` and fill in the values from your Azure App registration.
# `.env.local` is git-ignored — never commit real secrets.

# ──────────────────────────────────────────────────────────────────
# 1) Temporal UI — OIDC login (SSO)
# ──────────────────────────────────────────────────────────────────

# App registration -> Overview -> Directory (tenant) ID goes into the URL below
TEMPORAL_AUTH_PROVIDER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# App registration -> Overview -> Application (client) ID
TEMPORAL_AUTH_CLIENT_ID=<APPLICATION_CLIENT_ID>

# App registration -> Certificates & secrets -> New client secret -> copy the "Value"
TEMPORAL_AUTH_CLIENT_SECRET=<CLIENT_SECRET_VALUE>

# ──────────────────────────────────────────────────────────────────
# 2) Temporal Server — JWT verification (authorization)
# ──────────────────────────────────────────────────────────────────

# Azure AD JWKS endpoint — public keys for verifying token signatures.
# Same <TENANT_ID> as above.
TEMPORAL_JWT_KEY_SOURCE1=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys

# Optional second JWKS source (e.g. during a tenant migration).
# TEMPORAL_JWT_KEY_SOURCE2=

# Optional regex to parse the claim value into (namespace, role).
# Default (used when unset) matches "<namespace>:<role>" like "default:writer"
# or "system:admin" (grants admin on all namespaces).
# TEMPORAL_JWT_PERMISSIONS_REGEX=^(?P<namespace>[^:]+):(?P<role>[^:]+)$

# Note: TEMPORAL_AUTH_AUTHORIZER / TEMPORAL_AUTH_CLAIM_MAPPER / TEMPORAL_JWT_PERMISSIONS_CLAIM
# are set directly in docker-compose.yml (not here) because they are not tenant-specific.
